# Copy to .env.local and run: vercel link && vercel env pull .env.local --yes
#
# AI Gateway authentication
# ---------------------------------------------------------------------------
# On Vercel, OIDC is preferred and is populated automatically by `env pull`:
# VERCEL_OIDC_TOKEN
#
# Static gateway key (required for local dev, CI, and non-Vercel hosts).
# After provisioning the key in the Vercel dashboard, run `/env pull` so it
# lands in your .env.local automatically.
AI_GATEWAY_API_KEY=
