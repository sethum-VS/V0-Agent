{
  "name": "openclaw-daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run ./src/cli.ts",
    "build:binary": "bun build ./src/cli.ts --compile --target=bun-darwin-arm64 --outfile=../public/openclaw-mac",
    "build:binary:x64": "bun build ./src/cli.ts --compile --target=bun-darwin-x64 --outfile=../public/openclaw-mac-x64"
  },
  "devDependencies": {
    "@types/bun": "^1.1.13",
    "typescript": "^5.6.3"
  }
}
